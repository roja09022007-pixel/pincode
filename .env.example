# GEMINI_API_KEY: Required for Gemini AI API calls (optional server-side enrichment).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_N8N_WEBHOOK_URL: Optional external n8n webhook URL for automated postal verification workflow.
# If empty, the system runs using the local verification engine with realistic postal data.
VITE_N8N_WEBHOOK_URL="https://roja0902.app.n8n.cloud/webhook/dd564b0c-2213-4c63-aed9-40d2a9338199/chat"

# VITE_N8N_CHAT_WEBHOOK_URL: n8n AI Chatbot webhook endpoint
VITE_N8N_CHAT_WEBHOOK_URL="https://roja0902.app.n8n.cloud/webhook/dd564b0c-2213-4c63-aed9-40d2a9338199/chat"

